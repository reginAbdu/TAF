# =============================================================================
# Autonomous QA Multi-Agent Framework - environment template
# Copy to `.env` and fill in. Never commit `.env`.
# =============================================================================

# --- Cloud LLM: Claude (Agents 1-3) ------------------------------------------
# API key from console.anthropic.com (an API key, not a claude.ai seat).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Any model id your org has access to.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=8192
CLAUDE_TIMEOUT_SECONDS=300

# --- Local LLM: Ollama + Qwen 2.5-Coder (Agent 4) ----------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=300

# --- TypeScript Playwright test repository -----------------------------------
# Fine-grained PAT with "Contents: Read and write" on the test repo only.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
# HTTPS clone URL (the token is injected as an auth header, not embedded in the URL).
TEST_REPO_URL=https://github.com/your-org/your-playwright-tests.git
# Absolute path of a DEDICATED local clone (cloned automatically if missing).
TEST_REPO_LOCAL_PATH=/Users/you/qa-agent/your-playwright-tests
TEST_REPO_BASE_BRANCH=main
# Folder (relative to the repo root) where <TICKET>.spec.ts files are written.
TEST_SPEC_DIR=tests/qa
GIT_PUSH_ENABLED=true
GIT_AUTHOR_NAME=QA Agent
GIT_AUTHOR_EMAIL=qa-agent@users.noreply.github.com
GIT_TIMEOUT_SECONDS=120

# --- pnpm / Playwright execution ---------------------------------------------
PNPM_INSTALL_TIMEOUT_SECONDS=600
PLAYWRIGHT_TIMEOUT_SECONDS=1800
# Set true to run `playwright install --with-deps chromium` before each run.
PLAYWRIGHT_INSTALL_BROWSERS=false
PLAYWRIGHT_EXTRA_ARGS=--reporter=line

# --- Paperclip Control Room & budget guard -----------------------------------
# Endpoint that receives run/agent/budget events (leave empty to disable).
PAPERCLIP_WEBHOOK_URL=http://localhost:3100/api/events
PAPERCLIP_API_KEY=
# Hard caps on Claude tokens (input + output). 0 disables a cap.
MAX_CLOUD_TOKENS_PER_RUN=250000
MAX_CLOUD_TOKENS_PER_DAY=2000000

# --- Service -----------------------------------------------------------------
# Shared secret n8n must send as the `X-API-Key` header (empty = no auth).
QA_SERVICE_API_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_DIFF_CHARS=120000
MAX_ENV_LOG_CHARS=40000
MAX_EXEC_LOG_CHARS_FOR_LLM=60000
CALLBACK_TIMEOUT_SECONDS=30
